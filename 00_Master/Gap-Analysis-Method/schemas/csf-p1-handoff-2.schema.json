{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "csf-p1-handoff-2.schema.json",
 "title": "Information Gathering P1 handoff (csf-p1-handoff/2)",
 "description": "Frozen facts of Phase 1 information gathering, exported by Information-Gathering.html v2.2 or later for Gap Analysis. P1 carries facts only; Gap Analysis sets the Current Tier. v2.6 adds people, departments, department conflicts, document check results, and sampling results.",
 "type": "object",
 "required": [
  "schema",
  "engagement",
  "subcategories",
  "categories",
  "systems",
  "vendors",
  "environment",
  "technicalChecks",
  "documents",
  "evidence",
  "observations",
  "requests",
  "landscape",
  "people",
  "departments",
  "departmentConflicts"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "csf-p1-handoff/2"
  },
  "engagement": {
   "type": "object",
   "required": [
    "client",
    "alias",
    "reference",
    "cutoff",
    "scale",
    "industry",
    "flags",
    "appVersion",
    "stateSchema",
    "questionSetHash",
    "exported",
    "sourceHash",
    "aliased"
   ],
   "properties": {
    "scale": {
     "enum": [
      "S",
      "M",
      "L"
     ]
    },
    "industry": {
     "enum": [
      "gen",
      "hc",
      "mfg",
      "fin",
      "hosp",
      "util",
      "pub"
     ]
    },
    "flags": {
     "type": "object",
     "additionalProperties": {
      "type": "boolean"
     }
    },
    "stateSchema": {
     "const": "csf-ig/4"
    },
    "aliased": {
     "type": "boolean"
    },
    "questionSetHash": {
     "type": "string",
     "minLength": 1
    },
    "sourceHash": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "subcategories": {
   "type": "array",
   "minItems": 106,
   "maxItems": 106,
   "items": {
    "type": "object",
    "required": [
     "id",
     "function",
     "category",
     "session",
     "sufficiency",
     "sufficiencyReason",
     "notApplicable",
     "notApplicableReason",
     "evidenceIds",
     "coverage",
     "log",
     "requests",
     "conflict",
     "mandates",
     "references",
     "answeredBy"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^(GV|ID|PR|DE|RS|RC)\\.[A-Z]{2}-\\d{2}$"
     },
     "function": {
      "enum": [
       "GV",
       "ID",
       "PR",
       "DE",
       "RS",
       "RC"
      ]
     },
     "sufficiency": {
      "enum": [
       "ok",
       "pend",
       "need",
       "unc",
       "conf",
       "open",
       "na"
      ]
     },
     "notApplicable": {
      "type": "boolean"
     },
     "evidenceIds": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^EV-[A-Z0-9]{1,8}-\\d{3,}$"
      }
     },
     "coverage": {
      "type": "object",
      "required": [
       "applicable",
       "band",
       "pct"
      ]
     },
     "log": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "person",
        "mode",
        "answer",
        "text",
        "evidenceId"
       ],
       "properties": {
        "mode": {
         "enum": [
          "said",
          "shown"
         ]
        },
        "answer": {
         "enum": [
          "",
          "Y",
          "P",
          "N",
          "U"
         ]
        },
        "evidenceId": {
         "type": "string",
         "pattern": "^(EV-[A-Z0-9]{1,8}-\\d{3,})?$"
        },
        "personRole": {
         "type": "string"
        }
       }
      }
     },
     "requests": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "item",
        "status"
       ],
       "properties": {
        "status": {
         "enum": [
          "req",
          "recv",
          "none"
         ]
        }
       }
      }
     }
    },
    "not": {
     "anyOf": [
      {
       "required": [
        "statedTier"
       ]
      },
      {
       "required": [
        "countedTier"
       ]
      }
     ]
    }
   }
  },
  "categories": {
   "type": "array",
   "minItems": 22,
   "maxItems": 22,
   "items": {
    "type": "object",
    "required": [
     "id",
     "function",
     "subcategories",
     "screening",
     "depth",
     "sufficiency"
    ],
    "properties": {
     "screening": {
      "enum": [
       "",
       "Y",
       "P",
       "N",
       "U"
      ]
     },
     "depth": {
      "enum": [
       "open",
       "drill",
       "batch"
      ]
     }
    },
    "not": {
     "anyOf": [
      {
       "required": [
        "currentTier"
       ]
      },
      {
       "required": [
        "suggestedTier"
       ]
      }
     ]
    }
   }
  },
  "systems": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "impact",
     "criticality",
     "sampled",
     "profile"
    ],
    "properties": {
     "sampling": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "control",
        "value",
        "source",
        "evidenceRef"
       ],
       "properties": {
        "value": {
         "enum": [
          "",
          "Y",
          "P",
          "N",
          "NA",
          "U"
         ]
        },
        "source": {
         "enum": [
          "",
          "manual",
          "profile"
         ]
        }
       }
      }
     }
    }
   }
  },
  "vendors": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "profile",
     "systems"
    ]
   }
  },
  "environment": {
   "type": "object",
   "required": [
    "fields",
    "tables"
   ]
  },
  "technicalChecks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "result"
    ],
    "properties": {
     "result": {
      "enum": [
       "",
       "Y",
       "P",
       "N",
       "NA"
      ]
     }
    }
   }
  },
  "documents": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "level",
     "status",
     "reviewDepth",
     "evidenceIds"
    ],
    "properties": {
     "status": {
      "enum": [
       "",
       "Exists",
       "Partial",
       "Missing",
       "NA"
      ]
     },
     "reviewDepth": {
      "enum": [
       "Q",
       "F"
      ]
     },
     "checks": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "result"
       ],
       "properties": {
        "result": {
         "enum": [
          "",
          "P",
          "F",
          "NA"
         ]
        }
       }
      }
     }
    }
   }
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "title",
     "recordDate",
     "received",
     "confidentiality",
     "subcategories",
     "afterCutoff"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^EV-[A-Z0-9]{1,8}-\\d{3,}$"
     },
     "confidentiality": {
      "enum": [
       "N",
       "R"
      ]
     }
    }
   }
  },
  "observations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "description",
     "severity"
    ]
   }
  },
  "requests": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "item",
     "owner",
     "type",
     "status"
    ]
   }
  },
  "landscape": {
   "type": "object",
   "required": [
    "locked",
    "lockedAt",
    "facts"
   ],
   "properties": {
    "locked": {
     "const": true
    },
    "facts": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "block",
       "text",
       "evidence"
      ],
      "properties": {
       "block": {
        "enum": [
         "Systems",
         "Identity",
         "Backup",
         "Monitoring",
         "Suppliers",
         "Tools",
         "Incidents",
         "Changes",
         "Other"
        ]
       },
       "text": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   }
  },
  "people": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "role",
     "department",
     "interviewDate"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^P-\\d{2,}$"
     }
    }
   }
  },
  "departments": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "interviewees",
     "systemsUsed",
     "answers",
     "custom"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^DEPT-\\d{2,}$"
     },
     "answers": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "question",
        "answer",
        "rating"
       ]
      }
     }
    }
   }
  },
  "departmentConflicts": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "department",
     "type",
     "detail"
    ]
   }
  }
 }
}