{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "csf-gap-analyst/5",
 "title": "AI Analyst output for one CSF Function (Gap Analysis Stage 1), version 5",
 "description": "Text and judgments only. The HTML calculates tiers, coverage, risk scores, Risk Levels, and priority order, so those fields are not allowed here. Version 2 splits each Gap Finding into four layers. Version 3 adds Landscape references, the repeat finding flag, and the change-in-flight and existing-tool links on Improvement Actions. Version 4 replaces the four response angles with six stages (Fix, Find, Prevent, Handle exceptions, Validate, Sustain), adds a status per stage that follows the Target Tier, and adds the Register documents linked to each Gap Finding. Version 5 renames the Improvement Action key angle to stage; nothing else changes.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "function",
  "round",
  "categories",
  "improvementActions",
  "verify"
 ],
 "properties": {
  "schema": {
   "const": "csf-gap-analyst/5"
  },
  "function": {
   "enum": [
    "GV",
    "ID",
    "PR",
    "DE",
    "RS",
    "RC"
   ]
  },
  "round": {
   "type": "integer",
   "minimum": 1,
   "maximum": 3,
   "description": "1 first draft, 2 after Reviewer feedback, 3 after assessor comments"
  },
  "categories": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/category"
   }
  },
  "improvementActions": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/imp"
   }
  },
  "verify": {
   "type": "array",
   "description": "Open [VERIFY] items for the assessor. A Function locks only when this list is empty.",
   "items": {
    "$ref": "#/$defs/verifyItem"
   }
  }
 },
 "$defs": {
  "catId": {
   "type": "string",
   "pattern": "^(GV|ID|PR|DE|RS|RC)\\.[A-Z]{2}$"
  },
  "subId": {
   "type": "string",
   "pattern": "^(GV|ID|PR|DE|RS|RC)\\.[A-Z]{2}-[0-9]{2}$"
  },
  "evidenceRef": {
   "type": "string",
   "description": "Evidence ID from the input pack: Subcategory ID, technical check ID (for example IAM-01), profile field with system (for example C4:HIS), sampling control with system (for example mfa:PACS), observation ID (OBS-01), document ID, or NOTE:<Subcategory ID> for interview notes, Environment field ENV:<key>, population result POP:<field>, or a Landscape row ID (SITE-, TOOL-, HIST-, CHG-, PRIOR-)",
   "minLength": 2
  },
  "text": {
   "type": "string",
   "minLength": 1,
   "maxLength": 900
  },
  "category": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "categoryId",
    "keyMessage",
    "whatWorksToday",
    "strengths",
    "gapFindings",
    "observations"
   ],
   "properties": {
    "categoryId": {
     "$ref": "#/$defs/catId"
    },
    "keyMessage": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "found",
      "closes"
     ],
     "description": "Two-statement conclusion. found: the property of the organization with its consequence. closes: the first concrete move, starting with a verb.",
     "properties": {
      "found": {
       "$ref": "#/$defs/text"
      },
      "closes": {
       "$ref": "#/$defs/text"
      }
     }
    },
    "whatWorksToday": {
     "type": "string",
     "maxLength": 600,
     "description": "One sentence naming the Strengths and Foundations, empty string if none"
    },
    "strengths": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/strength"
     }
    },
    "gapFindings": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/gapFinding"
     }
    },
    "observations": {
     "type": "array",
     "description": "For Subcategories with status Meets with Observation only",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "subcategory",
       "statement",
       "evidence"
      ],
      "properties": {
       "subcategory": {
        "$ref": "#/$defs/subId"
       },
       "statement": {
        "$ref": "#/$defs/text"
       },
       "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
         "$ref": "#/$defs/evidenceRef"
        }
       }
      }
     }
    }
   }
  },
  "strength": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "type",
    "statement",
    "evidence"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^STR-(GV|ID|PR|DE|RS|RC)\\.[A-Z]{2}-[0-9]{2}$",
     "description": "Use the Subcategory ID that the HTML marked Strength or Foundation"
    },
    "type": {
     "enum": [
      "Strength",
      "Foundation"
     ]
    },
    "statement": {
     "$ref": "#/$defs/text"
    },
    "evidence": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/evidenceRef"
     }
    }
   }
  },
  "areaScore": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "value",
    "rationale"
   ],
   "properties": {
    "value": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 5
    },
    "rationale": {
     "type": "string",
     "maxLength": 400
    }
   }
  },
  "gapFinding": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "basis",
    "confidence",
    "title",
    "statement",
    "supportingFacts",
    "extent",
    "linkedSubcategories",
    "evidence",
    "rootCause",
    "consequence",
    "likelihood",
    "impact",
    "responses",
    "landscapeRefs",
    "repeatFinding",
    "documents",
    "documentGaps"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^GAP-(GV|ID|PR|DE|RS|RC)\\.[A-Z]{2}-[0-9]{2}$"
    },
    "basis": {
     "enum": [
      "Observed",
      "Inferred"
     ]
    },
    "confidence": {
     "enum": [
      "High",
      "Medium",
      "Low",
      null
     ],
     "description": "Required for Inferred, null for Observed"
    },
    "title": {
     "type": "string",
     "minLength": 5,
     "maxLength": 100,
     "description": "Layer 1. Headline of the gap in 12 words or fewer: the condition only. No system list, no consequence, no recommendation."
    },
    "statement": {
     "type": "string",
     "minLength": 1,
     "maxLength": 300,
     "description": "Layer 2. Analyzed conclusion in 35 words or fewer: the property of the organization and why it holds. No system lists or counts (those go in supportingFacts). No business effect (that goes in consequence). No recommendation."
    },
    "supportingFacts": {
     "type": "array",
     "minItems": 1,
     "maxItems": 5,
     "description": "Layer 3. The verifiable facts behind the statement, one fact per item, 25 words or fewer each. Facts state what was observed: systems, counts, check results. No interpretation.",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "fact",
       "evidence"
      ],
      "properties": {
       "fact": {
        "type": "string",
        "minLength": 5,
        "maxLength": 220
       },
       "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
         "$ref": "#/$defs/evidenceRef"
        },
        "description": "Evidence IDs for this fact. Each ID must also appear in the finding evidence list."
       }
      }
     }
    },
    "extent": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "confirmed",
      "likely",
      "notChecked"
     ],
     "properties": {
      "confirmed": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Systems or units where the condition is confirmed"
      },
      "likely": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Systems or units likely affected (Inferred)"
      },
      "notChecked": {
       "type": "string",
       "maxLength": 300,
       "description": "What the population outside the evidence is, for example '23 systems not profiled'"
      }
     }
    },
    "linkedSubcategories": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/subId"
     }
    },
    "evidence": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/evidenceRef"
     }
    },
    "rootCause": {
     "type": "array",
     "minItems": 1,
     "maxItems": 2,
     "uniqueItems": true,
     "items": {
      "enum": [
       "Ownership",
       "Capacity",
       "Skills",
       "Budget",
       "Tooling",
       "Vendor dependency"
      ]
     }
    },
    "consequence": {
     "type": "string",
     "minLength": 1,
     "maxLength": 300,
     "description": "Layer 4. Threat scenario and business effect for this client in 35 words or fewer. Do not repeat the statement."
    },
    "likelihood": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "value",
      "anchor",
      "rationale",
      "evidence"
     ],
     "description": "Proposal only. The assessor decides. value is null when confidence is Low.",
     "properties": {
      "value": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 1,
       "maximum": 5
      },
      "anchor": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^L[1-5]-[a-z]$",
       "description": "Calibration anchor ID used, for example L4-a"
      },
      "rationale": {
       "type": "string",
       "maxLength": 500
      },
      "evidence": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/evidenceRef"
       }
      }
     }
    },
    "impact": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "ops",
      "fin",
      "legal",
      "rep",
      "safety",
      "data"
     ],
     "description": "Proposal only, on the Workshop impact scale. The assessor decides.",
     "properties": {
      "ops": {
       "$ref": "#/$defs/areaScore"
      },
      "fin": {
       "$ref": "#/$defs/areaScore"
      },
      "legal": {
       "$ref": "#/$defs/areaScore"
      },
      "rep": {
       "$ref": "#/$defs/areaScore"
      },
      "safety": {
       "$ref": "#/$defs/areaScore"
      },
      "data": {
       "$ref": "#/$defs/areaScore"
      }
     }
    },
    "responses": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "fix",
      "find",
      "prevent",
      "exceptions",
      "validate",
      "sustain",
      "stageStatus",
      "notApplicable"
     ],
     "description": "IMP IDs per response stage. stageStatus says for each stage whether it is Required (the list holds IMPs), In place (a Strength or Foundation already operates it), Not applicable (does not apply to this gap), or Beyond Target Tier (only Sustain, only when the Target Tier of the Category is below 3). Any status other than Required needs a reason in notApplicable and an empty list.",
     "properties": {
      "fix": {
       "$ref": "#/$defs/impIdList"
      },
      "find": {
       "$ref": "#/$defs/impIdList"
      },
      "prevent": {
       "$ref": "#/$defs/impIdList"
      },
      "exceptions": {
       "$ref": "#/$defs/impIdList"
      },
      "validate": {
       "$ref": "#/$defs/impIdList"
      },
      "sustain": {
       "$ref": "#/$defs/impIdList"
      },
      "stageStatus": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "fix",
        "find",
        "prevent",
        "exceptions",
        "validate",
        "sustain"
       ],
       "properties": {
        "fix": {
         "enum": [
          "Required",
          "In place",
          "Not applicable",
          "Beyond Target Tier"
         ]
        },
        "find": {
         "enum": [
          "Required",
          "In place",
          "Not applicable",
          "Beyond Target Tier"
         ]
        },
        "prevent": {
         "enum": [
          "Required",
          "In place",
          "Not applicable",
          "Beyond Target Tier"
         ]
        },
        "exceptions": {
         "enum": [
          "Required",
          "In place",
          "Not applicable",
          "Beyond Target Tier"
         ]
        },
        "validate": {
         "enum": [
          "Required",
          "In place",
          "Not applicable",
          "Beyond Target Tier"
         ]
        },
        "sustain": {
         "enum": [
          "Required",
          "In place",
          "Not applicable",
          "Beyond Target Tier"
         ]
        }
       }
      },
      "notApplicable": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "fix": {
         "type": "string",
         "maxLength": 300
        },
        "find": {
         "type": "string",
         "maxLength": 300
        },
        "prevent": {
         "type": "string",
         "maxLength": 300
        },
        "exceptions": {
         "type": "string",
         "maxLength": 300
        },
        "validate": {
         "type": "string",
         "maxLength": 300
        },
        "sustain": {
         "type": "string",
         "maxLength": 300
        }
       }
      }
     }
    },
    "landscapeRefs": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^B([1-9]|1[0-4])$"
     },
     "description": "Landscape blocks this finding relies on, for example B2 for the critical service in the consequence and B10 for the extent"
    },
    "repeatFinding": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "value",
      "priorRef"
     ],
     "description": "value true when a prior assessment (Landscape B14) reported the same condition. priorRef is the PRIOR row ID, null when value is false",
     "properties": {
      "value": {
       "type": "boolean"
      },
      "priorRef": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "^PRIOR-[0-9]{2}$"
      }
     }
    },
    "documents": {
     "type": "array",
     "maxItems": 8,
     "description": "Framework documents linked to this Gap Finding, from the document register in the input pack. Never invent a document. The exception documents (GV-PRC-003, GV-FRM-004, GV-REG-004, GV-FRM-001) are the same for every Gap Finding, so list them only when this finding adds something specific.",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "status"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^(GV|ID|PR|DE|RS|RC)-[A-Z]{3}-[0-9]{3}$"
       },
       "status": {
        "enum": [
         "Exists",
         "Needs update",
         "Missing",
         "Not verified"
        ],
        "description": "Use the requestStatus in the input: Received is Exists, Does not exist is Missing. Use Not verified when the input does not say."
       }
      }
     }
    },
    "documentGaps": {
     "type": "array",
     "maxItems": 3,
     "description": "Records or documents this finding needs for the Target Tier that have no match in the document register, one short phrase each. The assessor passes them to the framework improvement list.",
     "items": {
      "type": "string",
      "minLength": 5,
      "maxLength": 160
     }
    }
   }
  },
  "impIdList": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^IMP-(GV|ID|PR|DE|RS|RC)\\.[A-Z]{2}-[0-9]{2}-[0-9]{2}$"
   }
  },
  "imp": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "stage",
    "action",
    "linkedGaps",
    "gapType",
    "buildsOn",
    "documents",
    "prerequisites",
    "systems",
    "changeInFlight",
    "existingTool"
   ],
   "description": "Atomic action. No cost, duration, phase, or owner: those belong to P3 Roadmap.",
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^IMP-(GV|ID|PR|DE|RS|RC)\\.[A-Z]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "stage": {
     "enum": [
      "Fix",
      "Find",
      "Prevent",
      "Handle exceptions",
      "Validate",
      "Sustain"
     ]
    },
    "action": {
     "type": "string",
     "minLength": 5,
     "maxLength": 400,
     "description": "Starts with a verb. One action."
    },
    "linkedGaps": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^GAP-(GV|ID|PR|DE|RS|RC)\\.[A-Z]{2}-[0-9]{2}$"
     }
    },
    "gapType": {
     "enum": [
      "Governance",
      "Process",
      "Technology",
      "Measurement",
      "Evidence"
     ]
    },
    "buildsOn": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^STR-"
     }
    },
    "documents": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^(GV|ID|PR|DE|RS|RC)-[A-Z]{3}-[0-9]{3}$"
     }
    },
    "prerequisites": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^IMP-"
     }
    },
    "systems": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "changeInFlight": {
     "type": [
      "object",
      "null"
     ],
     "description": "Required when a system in this IMP appears in a change in flight with within12Months true. Null otherwise",
     "additionalProperties": false,
     "required": [
      "ref",
      "appliesTo"
     ],
     "properties": {
      "ref": {
       "type": "string",
       "pattern": "^CHG-[0-9]{2}$"
      },
      "appliesTo": {
       "enum": [
        "Current system",
        "Replacement",
        "Both"
       ]
      }
     }
    },
    "existingTool": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^TOOL-[0-9]{2}$",
     "description": "The TOOL row this IMP uses. When that tool is Bought, not deployed, the action starts with Deploy. Null when no listed tool applies"
    }
   }
  },
  "verifyItem": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "ref",
    "question"
   ],
   "properties": {
    "ref": {
     "type": "string",
     "description": "Gap, Strength, IMP, or evidence ID the question is about"
    },
    "question": {
     "type": "string",
     "minLength": 5,
     "maxLength": 400
    }
   }
  }
 }
}