{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "csf-gap-review/2",
 "title": "AI Reviewer feedback for one CSF Function (Gap Analysis Stage 1, step 2), version 2",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "function",
  "reviewedRound",
  "checks",
  "verdict"
 ],
 "properties": {
  "schema": {
   "const": "csf-gap-review/2"
  },
  "function": {
   "enum": [
    "GV",
    "ID",
    "PR",
    "DE",
    "RS",
    "RC"
   ]
  },
  "reviewedRound": {
   "const": 1,
   "description": "The Reviewer reviews the first draft only. There is one feedback round."
  },
  "checks": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "check",
     "target",
     "result",
     "note",
     "requiredChange"
    ],
    "properties": {
     "check": {
      "type": "string",
      "pattern": "^C(0[1-9]|1[0-9]|2[01])$"
     },
     "target": {
      "type": "string",
      "description": "Finding, Strength, IMP, Category ID, or ALL"
     },
     "result": {
      "enum": [
       "Pass",
       "Fail"
      ]
     },
     "note": {
      "type": "string",
      "maxLength": 500
     },
     "requiredChange": {
      "type": "string",
      "maxLength": 500,
      "description": "Empty when result is Pass"
     }
    }
   }
  },
  "verdict": {
   "enum": [
    "Accept",
    "Revise"
   ],
   "description": "Revise when any check fails"
  }
 },
 "description": "Version 2 accepts checks C01 to C21 (Landscape checks C17 to C19 and the finding layer check C16 from method pack 1.2, Target Tier depth C20 and documents C21 from method pack 1.3). Widened in place in 1.3: older outputs still pass."
}
