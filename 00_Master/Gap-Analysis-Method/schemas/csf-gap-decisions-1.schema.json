{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csf-gap-decisions/1",
  "title": "Assessor decisions sent back to the Analyst (Gap Analysis Stage 1, step 6)",
  "description": "Generated by the HTML from the assessor's review screen. Decisions are final.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "function", "resolvedVerify", "decisions", "comments"],
  "properties": {
    "schema": { "const": "csf-gap-decisions/1" },
    "function": { "enum": ["GV", "ID", "PR", "DE", "RS", "RC"] },
    "resolvedVerify": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ref", "question", "answer"],
        "properties": { "ref": { "type": "string" }, "question": { "type": "string" }, "answer": { "type": "string", "minLength": 1 } }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ref", "field", "value"],
        "properties": {
          "ref": { "type": "string", "pattern": "^(GAP|STR|IMP)-" },
          "field": { "enum": ["basis", "confidence", "likelihood", "impact.ops", "impact.fin", "impact.legal", "impact.rep", "impact.safety", "impact.data", "rootCause", "remove"] },
          "value": {},
          "reason": { "type": "string" }
        }
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ref", "comment"],
        "properties": { "ref": { "type": "string" }, "comment": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
