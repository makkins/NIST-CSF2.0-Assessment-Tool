{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "csf-gap-landscape-facts/1",
 "title": "Current IT Landscape facts (Gap Analysis Stage 0)",
 "description": "Built by the Gap Analysis HTML (or tools/landscape_facts.py) from the Interview export csf-interview/3. Facts only: counts, lists, and recorded answers. No ratings, no gaps, no recommendations. The AI drafts key messages from it and the Analyst uses it as context.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "source",
  "asOf",
  "blocks",
  "securityTools",
  "changesInFlight",
  "priorAssessments",
  "incidentHistory"
 ],
 "properties": {
  "schema": {
   "const": "csf-gap-landscape-facts/1"
  },
  "source": {
   "type": "string",
   "description": "Interview schema version, for example csf-interview/3"
  },
  "asOf": {
   "type": "string",
   "description": "Export date. within12Months is calculated from this date"
  },
  "blocks": {
   "type": "object",
   "additionalProperties": false,
   "patternProperties": {
    "^B([1-9]|1[0-4])$": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "facts"
     ],
     "properties": {
      "name": {
       "type": "string"
      },
      "facts": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "text",
         "evidence"
        ],
        "properties": {
         "text": {
          "type": "string",
          "minLength": 3,
          "maxLength": 400,
          "description": "One fact, stated without rating words"
         },
         "evidence": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 2
          },
          "description": "Evidence IDs: ENV:<key>, POP:<field>, <field>:<system>, SITE-, TOOL-, HIST-, CHG-, PRIOR-, OBS-, V<n>:<vendor>"
         }
        }
       }
      },
      "assessorNote": {
       "type": "string",
       "maxLength": 600
      }
     }
    }
   },
   "description": "B1 to B14. A block with no facts stays in the object with an empty list, so the reference check can see it"
  },
  "securityTools": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "capability",
     "product",
     "coverage",
     "operatedBy",
     "status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^TOOL-[0-9]{2}$"
     },
     "capability": {
      "type": "string"
     },
     "product": {
      "type": "string"
     },
     "coverage": {
      "enum": [
       "Full",
       "Partial",
       "None",
       ""
      ]
     },
     "operatedBy": {
      "enum": [
       "In-house",
       "MSSP",
       "Vendor",
       "Nobody",
       ""
      ]
     },
     "status": {
      "enum": [
       "In use",
       "Bought, not deployed",
       "Planned",
       ""
      ]
     },
     "notes": {
      "type": "string"
     }
    }
   }
  },
  "changesInFlight": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "project",
     "systems",
     "targetDate",
     "status",
     "within12Months"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^CHG-[0-9]{2}$"
     },
     "project": {
      "type": "string"
     },
     "systems": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "targetDate": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "within12Months": {
      "type": "boolean"
     }
    }
   }
  },
  "priorAssessments": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "type",
     "date",
     "performedBy",
     "findingsOpen",
     "findingsClosed"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^PRIOR-[0-9]{2}$"
     },
     "type": {
      "type": "string"
     },
     "date": {
      "type": "string"
     },
     "performedBy": {
      "type": "string"
     },
     "findingsOpen": {
      "type": [
       "integer",
       "null"
      ]
     },
     "findingsClosed": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   }
  },
  "incidentHistory": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "date",
     "type",
     "systems",
     "impact",
     "reported"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^HIST-[0-9]{2}$"
     },
     "date": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "systems": {
      "type": "string"
     },
     "impact": {
      "type": "string"
     },
     "reported": {
      "type": "string"
     }
    }
   }
  },
  "departmentConflicts": {
   "type": "array",
   "description": "Conflicts between department answers (S2C) and IT answers. Observed evidence that practice differs from what IT stated",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "department",
     "type",
     "detail",
     "evidence"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^DCF-[0-9]{2}$"
     },
     "department": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "detail": {
      "type": "string"
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}
