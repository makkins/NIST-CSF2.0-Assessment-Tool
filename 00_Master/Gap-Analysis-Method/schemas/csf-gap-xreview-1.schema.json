{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csf-gap-xreview/1",
  "title": "AI Reviewer 2 cross-function proposals (Gap Analysis Stage 2)",
  "description": "Proposals only. Locked Function content is never edited here. The assessor accepts or rejects each proposal in the HTML.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "proposals"],
  "properties": {
    "schema": { "const": "csf-gap-xreview/1" },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "targets", "proposal", "rationale", "change"],
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]{2}$" },
          "type": { "enum": ["MergeIMP", "SystemicRootCause", "Calibration", "MissingLink", "Consistency"] },
          "targets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "proposal": { "type": "string", "maxLength": 500 },
          "rationale": { "type": "string", "maxLength": 600 },
          "change": {
            "type": "object",
            "additionalProperties": false,
            "description": "Machine-readable change the HTML applies when the assessor accepts",
            "properties": {
              "keepImp": { "type": "string", "pattern": "^IMP-" },
              "removeImps": { "type": "array", "items": { "type": "string", "pattern": "^IMP-" } },
              "mergedAction": { "type": "string", "maxLength": 400 },
              "systemicCause": { "enum": ["Ownership", "Capacity", "Skills", "Budget", "Tooling", "Vendor dependency"] },
              "systemicStatement": { "type": "string", "maxLength": 600 },
              "affectedGaps": { "type": "array", "items": { "type": "string", "pattern": "^GAP-" } },
              "suggestedLikelihood": { "type": "integer", "minimum": 1, "maximum": 5 },
              "addLinks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["imp", "gap"], "properties": { "imp": { "type": "string" }, "gap": { "type": "string" } } } },
              "note": { "type": "string", "maxLength": 400 }
            }
          }
        }
      }
    }
  }
}
